# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!scripts/marketing-shots/.env.example
!scripts/clone-store/.env.example

# marketing screenshot raw captures (processed assets live in public/assets)
scripts/marketing-shots/raw/*
!scripts/marketing-shots/raw/.gitkeep
scripts/marketing-shots/.env.local
scripts/marketing-shots/product-images/*
!scripts/marketing-shots/product-images/.gitkeep
scripts/marketing-shots/category-images/*
!scripts/marketing-shots/category-images/.gitkeep

# clone-store runs (credentials, sessions, scraped images)
scripts/clone-store/.env.local
scripts/clone-store/runs/*
!scripts/clone-store/runs/.gitkeep
!scripts/clone-store/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
