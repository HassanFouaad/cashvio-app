# Copy to .env.local (gitignored) OR pass flags / env at runtime.
CASHVIO_CONSOLE_URL=https://console.cash-vio.com
CASHVIO_API_URL=https://console.cash-vio.com/api
CASHVIO_STOREFRONT_HOST=cash-vio.com

# System-admin refresh token (from a SYSTEM audience login cookie cv_refresh_token)
CASHVIO_SYSTEM_REFRESH_TOKEN=

# Optional overrides
# CLONE_SOURCE_URL=https://example-shop.com
# CLONE_STORE_NAME=
# CLONE_INDUSTRY=fashion
# CLONE_THEME=EDITORIAL
# CLONE_PLAN_ID=
# CLONE_ADMIN_EMAIL=
# CLONE_ADMIN_PASSWORD=
# CLONE_CONTACT_PHONE=+201234567890
# CLONE_MAX_PRODUCTS=80
# CLONE_DEFAULT_STOCK=50
# CLONE_COST_RATIO=0.4
# CLONE_ONBOARDING_WAIT_MS=3000
