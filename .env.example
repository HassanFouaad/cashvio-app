# =============================================================================
# Marketing Site (my-app) Environment Configuration
# =============================================================================
# Copy to .env.local for local overrides (gitignored).
# All client-facing vars must use the NEXT_PUBLIC_ prefix (Next.js requirement).
# Central resolver: src/config/env.ts

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Site URLs
# -----------------------------------------------------------------------------
# Public marketing site (this app). Dev server: npm run dev (port 3005)
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Merchant tenant portal (login, dashboard redirects)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002

# Cross-subdomain preference cookies (theme, language). Auth cookies are HttpOnly
# and set by the backend — not configured here.
NEXT_PUBLIC_COOKIE_DOMAIN=.cash-vio.com

# -----------------------------------------------------------------------------
# Site metadata
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Cashvio
NEXT_PUBLIC_SITE_DESCRIPTION=Free POS and free online store for retail shops

# -----------------------------------------------------------------------------
# Contact
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=support@cash-vio.com
# NEXT_PUBLIC_CONTACT_PHONE=+201234567890
# WhatsApp in international format (digits or +). Falls back to CONTACT_PHONE.
# NEXT_PUBLIC_WHATSAPP_NUMBER=+201234567890
# NEXT_PUBLIC_CONTACT_ADDRESS=

# -----------------------------------------------------------------------------
# Social links (footer, JSON-LD). Empty = hidden or code fallback in site.ts/seo.ts
# -----------------------------------------------------------------------------
NEXT_PUBLIC_X_URL=https://x.com/cashvio
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/cashvio
# NEXT_PUBLIC_FACEBOOK_APP_ID=882610377639110
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/cashvioapp
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/cashvio
# NEXT_PUBLIC_YOUTUBE_URL=

# -----------------------------------------------------------------------------
# Analytics (optional — surfaces stay off when unset)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_FB_PIXEL_ID=

# -----------------------------------------------------------------------------
# Search / domain verification (optional — src/app/[locale]/layout.tsx metadata)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
# NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# -----------------------------------------------------------------------------
# Feature flags (set to "false" to disable)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_REGISTRATION=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true

# =============================================================================
# Dev scripts (separate env files — not read by Next.js at runtime)
# =============================================================================
# Store clone pipeline:  scripts/clone-store/.env.example
# Marketing screenshots:  scripts/marketing-shots/.env.example
